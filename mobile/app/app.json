{
  "expo": {
    "name": "app",
    "slug": "app",
    "scheme": "zkfyp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zk0008.collabgpt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zk0008.collabgpt"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-build-properties",
      ["expo-media-library", {
        "photosPermission": "Allow CollabGPT to access your photos.",
        "savePhotosPermission": "Allow CollabGPT to save images to your photo library.",
        "isAccessMediaLocationEnabled": false
      }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "830cea10-c81d-4136-8396-2be09da72a05"
      }
    },
    "owner": "zk0008"
  }
}
